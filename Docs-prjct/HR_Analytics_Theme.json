{
  "name": "HR Analytics Pro",
  "dataColors": ["#0F4C81", "#00A6A6", "#F2A541", "#E4572E", "#6C5B7B", "#8FB339", "#5C6B73", "#B8C4CE"],
  "background": "#FFFFFF",
  "foreground": "#1F2933",
  "tableAccent": "#0F4C81",
  "good": "#2E9E6B",
  "neutral": "#F2A541",
  "bad": "#E4572E",
  "maximum": "#0F4C81",
  "center": "#F2A541",
  "minimum": "#B8C4CE",
  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 14, "color": "#1F2933" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#52606D" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 28, "color": "#0F4C81" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#1F2933" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E4E7EB" } }, "radius": 6 }],
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#1F2933" } }, "fontFamily": "Segoe UI Semibold", "fontSize": 12 }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F5F7FA" } }, "transparency": 0 }]
      }
    }
  }
}
